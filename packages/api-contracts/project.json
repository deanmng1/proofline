{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api-contracts",
  "projectType": "library",
  "root": "packages/api-contracts",
  "sourceRoot": "packages/api-contracts/src",
  "targets": {
    "test": {
      "command": "pnpm exec vitest run packages/api-contracts/src"
    },
    "coverage": {
      "command": "pnpm exec vitest run packages/api-contracts/src --coverage --coverage.all --coverage.provider=v8 --coverage.reportsDirectory=artifacts/coverage/api-contracts --coverage.reporter=text --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=json-summary --coverage.include='packages/api-contracts/src/**/*.{ts,tsx}' --coverage.exclude='**/*.test.{ts,tsx}' --coverage.exclude='**/*.d.ts'",
      "outputs": ["{workspaceRoot}/artifacts/coverage/api-contracts"],
      "cache": false
    },
    "typecheck": {
      "command": "pnpm exec tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict packages/api-contracts/src/*.ts"
    }
  }
}
