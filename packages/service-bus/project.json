{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "service-bus",
  "projectType": "library",
  "root": "packages/service-bus",
  "sourceRoot": "packages/service-bus/src",
  "targets": {
    "test": {
      "command": "pnpm exec vitest run packages/service-bus/src"
    },
    "typecheck": {
      "command": "pnpm exec tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict packages/service-bus/src/*.ts"
    },
    "coverage": {
      "command": "pnpm exec vitest run packages/service-bus/src --coverage --coverage.all --coverage.provider=v8 --coverage.reportOnFailure --coverage.reportsDirectory=artifacts/coverage/service-bus --coverage.reporter=text --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=json-summary --coverage.include='packages/service-bus/src/**/*.{ts,tsx}' --coverage.exclude='**/*.test.{ts,tsx}' --coverage.exclude='**/*.d.ts'",
      "outputs": ["{workspaceRoot}/artifacts/coverage/service-bus"],
      "cache": false
    }
  }
}
