{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "domain",
  "projectType": "library",
  "root": "packages/domain",
  "sourceRoot": "packages/domain/src",
  "targets": {
    "test": {
      "command": "pnpm exec vitest run packages/domain/src"
    },
    "lint": {
      "command": "pnpm exec biome check packages/domain"
    },
    "typecheck": {
      "command": "pnpm exec tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict packages/domain/src/*.ts"
    }
  }
}
