{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "domain",
  "projectType": "library",
  "root": "packages/domain",
  "sourceRoot": "packages/domain/src",
  "targets": {
    "test": {
      "command": "pnpm exec vitest run packages/domain/src"
    },
    "coverage": {
      "command": "pnpm exec vitest run packages/domain/src --coverage --coverage.all --coverage.provider=v8 --coverage.reportOnFailure --coverage.reportsDirectory=artifacts/coverage/domain --coverage.reporter=text --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=json-summary --coverage.include='packages/domain/src/**/*.{ts,tsx}' --coverage.exclude='**/*.test.{ts,tsx}' --coverage.exclude='**/*.d.ts'",
      "outputs": ["{workspaceRoot}/artifacts/coverage/domain"],
      "cache": false
    },
    "lint": {
      "command": "pnpm exec biome check packages/domain"
    },
    "typecheck": {
      "command": "pnpm exec tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict packages/domain/src/*.ts"
    }
  }
}
