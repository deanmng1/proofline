{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "proofline-tools",
  "projectType": "library",
  "root": "tools/proofline",
  "sourceRoot": "tools/proofline/src",
  "targets": {
    "test": {
      "command": "pnpm exec vitest run tools/proofline/src"
    },
    "typecheck": {
      "command": "pnpm exec tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --strict tools/proofline/src/*.ts"
    },
    "coverage": {
      "command": "pnpm exec vitest run tools/proofline/src --coverage --coverage.all --coverage.provider=v8 --coverage.reportOnFailure --coverage.reportsDirectory=artifacts/coverage/proofline-tools --coverage.reporter=text --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=json-summary --coverage.include='tools/proofline/**/*.{ts,mjs}' --coverage.exclude='**/*.test.ts' --coverage.exclude='**/*.d.ts' --coverage.exclude='tools/proofline/check-production.mjs' --coverage.exclude='tools/proofline/egress-guard.mjs' --coverage.exclude='tools/proofline/serve-test-app.mjs'",
      "outputs": ["{workspaceRoot}/artifacts/coverage/proofline-tools"],
      "cache": false
    }
  }
}
