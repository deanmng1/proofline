"name: Verify CRM regression harness

on:
  pull_request:
  push:
    branches: [main, master]
  workflow_dispatch:
    inputs:
      cross_browser:
        description: Run the invariant smoke in Firefox and WebKit
        required: false
        default: false
        type: boolean

