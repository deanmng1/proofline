  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    env:
      IMPACT_BASE: ${{ github.event.pull_request.base.sha || github.event.before }}
      IMPACT_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
    steps:
      - name: Checkout full history for impact analysis
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          ref: ${{ github.event.pull_request.head.sha || github.sha }}

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 11.24.0

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: pnpm

      - name: Install dependencies
        id: dependencies
        run: pnpm install --frozen-lockfile

      - name: Lint
        run: pnpm lint

      - name: Typecheck
        run: pnpm typecheck

      - name: Validate portable harness manifest
        run: pnpm harness:validate

      - name: Build and audit the production application boundary
        shell: bash
        run: |
          mkdir -p artifacts
          set -o pipefail
          pnpm build 2>&1 | tee artifacts/proofline-production-output.txt
          pnpm proofline:check-production 2>&1 | tee -a artifacts/proofline-production-output.txt

      - name: Validate portable execution record and generated catalog
        run: pnpm record:check -- --base \"$IMPACT_BASE\" --head \"$IMPACT_HEAD\"

      - name: Install Chromium
        if: ${{ !cancelled() && steps.dependencies.outcome == 'success' }}
        run: pnpm exec playwright install --with-deps chromium

      - name: Install optional smoke browsers
        if: ${{ !cancelled() && steps.dependencies.outcome == 'success' && github.event_name == 'workflow_dispatch' && inputs.cross_browser }}
        run: pnpm exec playwright install --with-deps firefox webkit

      - name: Preview impact selection
        id: impact
        shell: bash
        run: |
          pnpm test:impacted -- --dry-run --base \"$IMPACT_BASE\" --head \"$IMPACT_HEAD\"
          echo \"fallback=$(node -p \\\"require('./artifacts/impact/selection.json').fallback\\\")\" >> \"$GITHUB_OUTPUT\"

      - name: Run impact-selected tests
        run: pnpm test:impacted -- --base \"$IMPACT_BASE\" --head \"$IMPACT_HEAD\"

      - name: Run full Vitest safety gate
        if: ${{ !cancelled() && steps.dependencies.outcome == 'success' }}
        shell: bash
        run: |
          mkdir -p artifacts
          set -o pipefail
          pnpm test 2>&1 | tee artifacts/vitest-output.txt

      - name: Run full Chromium safety gate
        if: ${{ !cancelled() && steps.dependencies.outcome == 'success' }}
        shell: bash
        run: |
          mkdir -p artifacts
          set -o pipefail
          pnpm e2e 2>&1 | tee artifacts/browser-output.txt

      - name: Run optional Firefox and WebKit invariant smoke
        if: ${{ !cancelled() && steps.dependencies.outcome == 'success' && github.event_name == 'workflow_dispatch' && inputs.cross_browser }}
        shell: bash
        env:
          PROOFLINE_CROSS_BROWSER: \"1\"
        run: |
          set -o pipefail
          pnpm exec playwright test --config apps/crm-e2e/playwright.config.ts apps/crm-e2e/src/proofline/cross-browser-smoke.spec.ts --project=firefox --project=webkit 2>&1 | tee -a artifacts/browser-output.txt

      - name: Generate Vitest coverage baseline
        if: ${{ !cancelled() && steps.dependencies.outcome == 'success' }}
        shell: bash
        run: |
          mkdir -p artifacts
          set -o pipefail
          pnpm coverage 2>&1 | tee artifacts/coverage-output.txt

      - name: Check scoped critical-file coverage ratchets
        if: ${{ !cancelled() && steps.dependencies.outcome == 'success' }}
        run: pnpm coverage:check -- --base \"$IMPACT_BASE\" --head \"$IMPACT_HEAD\"

      - name: Check patch whitespace
        if: ${{ !cancelled() && steps.dependencies.outcome == 'success' }}
        run: git diff --check

      - name: Upload coverage baseline
        if: ${{ always() }}
        uses: actions/upload-artifact@v4
        with:
          name: coverage-baseline
          if-no-files-found: warn
          retention-days: 14
          path: |
            artifacts/coverage/
            artifacts/coverage-output.txt

      - name: Upload immutable verification diagnostics
        if: ${{ always() }}
        uses: actions/upload-artifact@v4
