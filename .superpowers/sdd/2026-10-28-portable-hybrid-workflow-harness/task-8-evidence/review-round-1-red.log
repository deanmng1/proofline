            artifacts/vitest-output.txt
            artifacts/browser-output.txt
            artifacts/coverage-output.txt
            artifacts/proofline-production-output.txt
            dist/crm-web/.proofline/modules.json
            dist/crm-web/.vite/manifest.json
            playwright-report/
            test-results/
