{
  "name": "insurance-crm-testbed",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm nx run crm-web:serve",
    "build": "pnpm nx run crm-web:build",
    "preview": "pnpm nx run crm-web:preview",
    "test": "pnpm nx run crm-web:test",
    "test:watch": "pnpm nx run crm-web:test-watch",
    "e2e": "pnpm nx run crm-e2e:e2e",
    "test:e2e": "pnpm nx run crm-e2e:e2e",
    "e2e:ui": "pnpm exec playwright test --config apps/crm-e2e/playwright.config.ts --ui",
    "e2e:report": "pnpm exec playwright show-report",
    "test:impacted": "pnpm test && pnpm test:e2e",
    "typecheck": "pnpm nx run crm-web:typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,html,svg}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@testbed/api-contracts": "workspace:*",
    "@testbed/test-kit": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/browser": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.511.0",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.3.0",
    "nx": "^24.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
